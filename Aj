	local key=tostring(_G._ShadowKey or ""):match("^%s*(.-)%s*$")
	if not key:match("^SHADOW%-%d%d%d%d%-%d%d%d%d%-%d%d%d%d$") then
		Players.LocalPlayer:Kick("\n[Shadow Noti] No valid key — shadowaj.lovable.app")
