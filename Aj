	local pendingJoin=nil
	track(TeleportService.TeleportInitFailed:Connect(function(player,result,errMsg)
		if player~=LP or not pendingJoin then return end
		local job=pendingJoin; pendingJoin=nil; job.onFail(result,errMsg)
	end))
	local function joinServer(jobId,setStatus)
		if not jobId or jobId=="" then setStatus("No job",true); return end
		local retries=math.max(1,Config.WNJoinRetries or 3)
		local function attempt(n,useJobId)
			setStatus(n<retries and ("Retry "..(retries-n+1)) or "...",false)
			local watchdog
			local job={onFail=function(result,errMsg)
				if watchdog then _cancel(watchdog) end
				if n>1 then _tw(0.6); attempt(n-1,useJobId)
				elseif useJobId then attempt(retries,false)
				else setStatus("Full",true) end
			end}
			pendingJoin=job
			local ok,err=pcall(function()
				if useJobId then TeleportService:TeleportToPlaceInstance(PLACE_ID,jobId,LP)
				else TeleportService:Teleport(PLACE_ID,LP) end
			end)
			if not ok then pendingJoin=nil; job.onFail("pcall",err); return end
			watchdog=_delay(4,function()
				if pendingJoin==job then pendingJoin=nil; job.onFail("Timeout","no TeleportInitFailed") end
			end)
		end
		attempt(retries,true)
	end

	-- spam join: rapid-fire teleport attempts until _G.ShadowNotiCancel fires
	local spamActive=false
	local function spamJoin(jobId,setStatus)
		if not jobId or jobId=="" then return end
		spamActive=true
		_G.ShadowNotiCancel=function() spamActive=false end
		_spawn(function()
			local i=0; local maxAttempts=Config.WNMaxSpam or 0
			while spamActive and (maxAttempts==0 or i<maxAttempts) do
				i=i+1; setStatus("Spam "..i,false)
				pcall(function() TeleportService:TeleportToPlaceInstance(PLACE_ID,jobId,LP) end)
				_tw((Config.WNJoinSpeed or 300)/1000)
			end
			spamActive=false; setStatus("Spam Join",true)
		end)
	end

