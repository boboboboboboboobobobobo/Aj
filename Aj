		if httpReq then
			local ok,res=pcall(httpReq,{Url=SB_URL.."/rest/v1/finds?select=id&order=id.desc&limit=1",Method="GET",
				Headers={["apikey"]=SB_KEY,["Authorization"]="Bearer "..SB_KEY}})
			if ok and res and tonumber(res.StatusCode)==200 then
				local ok2,d=pcall(HttpService.JSONDecode,HttpService,res.Body)
				if ok2 and type(d)=="table" and d[1] then lastId=d[1].id or 0 end
			end
		end
		while true do
			_tw(0.5)
			if not httpReq then continue end
			local url=SB_URL.."/rest/v1/finds?select=*&order=id.asc&limit=20"
			if lastId>0 then url=url.."&id=gt."..lastId end
			local ok,res=pcall(httpReq,{Url=url,Method="GET",Headers={["apikey"]=SB_KEY,["Authorization"]="Bearer "..SB_KEY}})
			if not ok or not res or tonumber(res.StatusCode)~=200 then
				wsFailCount = wsFailCount + 1
				if wsFailCount >= 2 then _G.WNSetWS(false) end
				continue
			end
			wsFailCount = 0
			_G.WNSetWS(true)
			local ok2,data=pcall(HttpService.JSONDecode,HttpService,res.Body)
			if not ok2 or type(data)~="table" then continue end
			local hit=false
			for _,raw in ipairs(data) do
				if (raw.id or 0)>lastId then lastId=raw.id end
				local ok3,row=pcall(_pdec,raw.payload)
				if not ok3 or type(row)~="table" then continue end
				local nm=cleanName(row.name)
				if nm=="Unknown" or nm=="" then continue end
				local v=tonumber(row.price) or 0
