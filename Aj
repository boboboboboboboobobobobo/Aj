	local ESP_COLOR = Color3.fromRGB(79,216,158)
	local espData = {}
	local function clearESP(uid)
		local e = espData[uid]
		if not e then return end
		for _,c in ipairs(e.conns) do pcall(function() c:Disconnect() end) end
		if e.highlight then pcall(function() e.highlight:Destroy() end) end
		if e.billboard then pcall(function() e.billboard:Destroy() end) end
		espData[uid] = nil
	end
	local function applyESPToChar(char, entry)
		local hl = Instance.new("Highlight")
		hl.FillColor = ESP_COLOR
		hl.FillTransparency = 0.7
		hl.OutlineColor = ESP_COLOR
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = char
		entry.highlight = hl
		local head = char:FindFirstChild("Head") or char:WaitForChild("Head",4)
		if not head then return end
		local bb = Instance.new("BillboardGui")
		bb.Name = "ShadowUserTag"
		bb.Size = UDim2.fromOffset(170,40)
		bb.StudsOffset = Vector3.new(0,2.6,0)
		bb.AlwaysOnTop = true
		bb.Parent = head
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1,1)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamBlack
		lbl.Text = "SHADOW USER"
		lbl.TextSize = 18
		lbl.TextColor3 = ESP_COLOR
		lbl.TextStrokeTransparency = 0.35
		lbl.TextStrokeColor3 = Color3.new(0,0,0)
		lbl.Parent = bb
		entry.billboard = bb
	end
	local function applyESP(uid, plr)
		clearESP(uid)
		local entry = {conns={}}
		espData[uid] = entry
		if plr.Character then applyESPToChar(plr.Character, entry) end
		entry.conns[#entry.conns+1] = track(plr.CharacterAdded:Connect(function(char)
			applyESPToChar(char, entry)
		end))
	end
	track(Players.PlayerRemoving:Connect(function(plr) clearESP(tostring(plr.UserId)) end))

