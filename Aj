	local function upsertPresence()
		if not httpReq then return end
		local body=HttpService:JSONEncode({user_id=LP.UserId,username=LP.Name,display_name=LP.DisplayName,last_seen=DateTime.now():ToIsoDate(),plan=verifiedPlan})
		pcall(httpReq,{Url=SB_URL.."/rest/v1/active_users?on_conflict=user_id",Method="POST",
			Headers={["apikey"]=SB_KEY,["Authorization"]="Bearer "..SB_KEY,["Content-Type"]="application/json",
				["Prefer"]="resolution=merge-duplicates,return=minimal"},Body=body})
	end
	local function pollActiveUsers()
		if not httpReq then return end
		local ok,res=pcall(httpReq,{Url=SB_URL.."/rest/v1/active_users?select=user_id,username,display_name&order=last_seen.desc",Method="GET",
			Headers={["apikey"]=SB_KEY,["Authorization"]="Bearer "..SB_KEY}})
		if not ok or not res or res.StatusCode~=200 then return end
		local ok2,data=pcall(HttpService.JSONDecode,HttpService,res.Body)
		if ok2 and type(data)=="table" then refreshUsers(data) end
	end
	_spawn(function()
		upsertPresence()
		pollActiveUsers()
		while gui.Parent do _tw(30); upsertPresence(); pollActiveUsers() end
	end)

